<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        id="cordova-plugin-screenshare-live"
        version="1.0.0">

  <name>ScreenShareLive</name>
  <description>Live screen capture with Android MediaProjection for WebRTC</description>
  <license>MIT</license>

  <!-- API JavaScript exposée globalement comme ScreenShareLive -->
  <js-module src="www/ScreenShareLive.js" name="ScreenShareLive">
    <clobbers target="ScreenShareLive" />
  </js-module>

  <platform name="android">
    <!-- Enregistrement du plugin côté Cordova Android -->
    <config-file target="res/xml/config.xml" parent="/*">
      <feature name="ScreenShareLive">
        <param name="android-package" value="com.callapp.screenshare.ScreenShareLivePlugin"/>
        <param name="onload" value="true"/>
      </feature>
    </config-file>

    <!-- Permissions requises Android 14+ pour MediaProjection -->
    <config-file target="AndroidManifest.xml" parent="/*">
      <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
      <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
      <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    </config-file>

    <!-- Service au premier plan obligatoire pour la capture d'écran -->
    <config-file target="AndroidManifest.xml" parent="./application">
      <service
        android:name="com.callapp.screenshare.ScreenShareService"
        android:enabled="true"
        android:exported="false"
        android:foregroundServiceType="mediaProjection" />
    </config-file>

    <source-file src="src/android/ScreenShareLivePlugin.java"
                 target-dir="src/com/callapp/screenshare" />
    <source-file src="src/android/ScreenShareService.java"
                 target-dir="src/com/callapp/screenshare" />

    <!-- NotificationCompat -->
    <framework src="androidx.core:core:1.13.1" />
  </platform>
</plugin>
